{
  "name": "tongye-meet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run schema:generate && npm run docs:generate && npm run typecheck && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/fetch-tesseract.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json && tsc -p tsconfig.media.json",
    "lint": "eslint src/online src/server api src/App.tsx shared/*.ts worker/src tests scripts/*.ts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "docs:generate": "node --import tsx scripts/generate-help.ts",
    "docs:check": "node --import tsx scripts/docs-check.ts",
    "schema:generate": "node --import tsx scripts/generate-validator.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run docs:check && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply coukong-local --local --config worker/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply tongye-meet-production --remote --config worker/wrangler.production.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.production.jsonc",
    "assets:prepare": "node scripts/fetch-tesseract.mjs && node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "@vercel/oidc": "3.8.9",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "lz-string": "^1.5.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@playwright/test": "^1.63.0",
    "@types/lz-string": "^1.5.0",
    "@types/node": "24.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22 <27"
  }
}
